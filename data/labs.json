{
  "labs": [
    {
    "id": "lab1",
    "title": "Лабораторная работа №1",
    "topic": "Нормы векторов и матриц. Число обусловленности",
    "description": "Вычисление норм векторов и матриц, проверка неравенства для норм Фробениуса, вычисление числа обусловленности.",
    "tasks": [
        "Вычислить нормы вектора x (p=1, 2, inf)",
        "Вычислить нормы матрицы A (1, E, inf)",
        "Проверить неравенство 1/sqrt(n)||A|| <= ||A||_E <= sqrt(n)||A||",
        "Сравнить с scipy.linalg.norm",
        "Вычислить число обусловленности матрицы с a_ij = min(i,j)"
    ],
    "handler": { "module": "lab1", "function": "run_lab" },
    "output": { "type": "mixed", "title": "Результаты вычислений" },
    "inputs": [
        { 
        "name": "n", 
        "label": "Размерность (n)", 
        "type": "number", 
        "default": "5", 
        "step": "1", 
        "min": "2", 
        "max": "50" 
        },
        { 
        "name": "vector", 
        "label": "Вектор x (через запятую, опционально)", 
        "type": "text", 
        "default": "1.5, -2.0, 3.0, 0.5, -1.0" 
        },
        { 
        "name": "matrix_mode", 
        "label": "Матрица A", 
        "type": "select", 
        "options": ["Случайная", "a_ij = min(i,j)"], 
        "default": "Случайная" 
        }
    ]
    },
